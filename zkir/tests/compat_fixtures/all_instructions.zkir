{
  "version": { "major": 3, "minor": 1 },
  "inputs": [
    { "name": "%native", "type": "Scalar<BLS12-381>" },
    { "name": "%bool", "type": "Bool" },
    { "name": "%byte", "type": "Byte" },
    { "name": "%bytes", "type": "Bytes<32>" },
    { "name": "%bytes_wide", "type": "Bytes<64>" },
    { "name": "%jj_point", "type": "Point<Jubjub>" },
    { "name": "%jj_scalar", "type": "Scalar<Jubjub>" },
    { "name": "%k1_point", "type": "Point<Secp256k1>" },
    { "name": "%k1_base", "type": "Base<Secp256k1>" },
    { "name": "%k1_scalar", "type": "Scalar<Secp256k1>" },
    { "name": "%r1_point", "type": "Point<Secp256r1>" },
    { "name": "%r1_base", "type": "Base<Secp256r1>" },
    { "name": "%r1_scalar", "type": "Scalar<Secp256r1>" },
    { "name": "%c25519_point", "type": "Point<Curve25519>" },
    { "name": "%c25519_base", "type": "Base<Curve25519>" },
    { "name": "%c25519_scalar", "type": "Scalar<Curve25519>" }
  ],
  "outputs": ["Scalar<BLS12-381>"],
  "do_communications_commitment": false,
  "instructions": [
    { "op": "encode", "input": "%native", "outputs": ["%enc.0"] },
    { "op": "assert", "cond": "0x01" },
    { "op": "cond_select", "bit": "0x01", "a": "%native", "b": "0x00", "output": "%sel.0" },
    { "op": "constrain_bits", "val": "%native", "bits": 64 },
    { "op": "constrain_eq", "a": "%native", "b": "%native" },
    { "op": "constrain_to_boolean", "val": "0x01" },
    { "op": "copy", "val": "%native", "output": "%copy.0" },
    { "op": "impact", "guard": "0x01", "inputs": ["%native", "0x2a"] },
    { "op": "ec_mul", "a": "%jj_point", "scalar": "%jj_scalar", "output": "%ecmul.0" },
    { "op": "ec_mul_generator", "scalar": "%jj_scalar", "output": "%ecmulgen.0" },
    { "op": "hash_to_curve", "inputs": ["%native"], "output": "%h2c.0" },
    { "op": "into_coordinates", "point": "%jj_point", "outputs": ["%coord.x", "%coord.y"] },
    { "op": "from_coordinates", "inputs": ["%coord.x", "%coord.y"], "output": "%fc.0" },
    { "op": "into_bytes32", "input": "%native", "output": "%ib32.0" },
    { "op": "from_bytes32", "bytes": "%bytes", "type": "Scalar<BLS12-381>", "output": "%fb32.0" },
    { "op": "reverse_bytes", "bytes": "%bytes", "output": "%revb.0" },
    { "op": "slice", "bytes": "%bytes", "start": 1, "len": 3, "output": "%slice.0" },
    { "op": "bytes32_into_low_high", "bytes": "%bytes", "outputs": ["%lh.low", "%lh.high"] },
    { "op": "bytes32_from_low_high", "inputs": ["%lh.low", "%lh.high"], "output": "%flh.0" },
    { "op": "nth", "bytes": "%bytes", "index": 2, "output": "%nth.0" },
    { "op": "concat", "inputs": ["%bytes", "%bytes_wide"], "output": "%concat.0" },
    { "op": "load_constant", "type": "Scalar<Jubjub>", "encoding": ["0x07"], "output": "%const.0" },
    { "op": "div_mod_power_of_two", "val": "%native", "bits": 8, "outputs": ["%div.0", "%mod.0"] },
    { "op": "reconstitute_field", "divisor": "%div.0", "modulus": "%mod.0", "bits": 8, "output": "%recon.0" },
    { "op": "transient_hash", "inputs": ["%native"], "output": "%th.0" },
    { "op": "persistent_hash", "alignment": [ { "tag": "atom", "value": { "tag": "bytes", "length": 1 } } ], "inputs": ["%native"], "output": "%ph.0" },
    { "op": "keccak256", "alignment": [ { "tag": "atom", "value": { "tag": "bytes", "length": 1 } } ], "inputs": ["%native"], "output": "%kec.0" },
    { "op": "sha512", "alignment": [ { "tag": "atom", "value": { "tag": "bytes", "length": 1 } } ], "inputs": ["%native"], "output": "%sha.0" },
    { "op": "test_eq", "a": "%native", "b": "0x2a", "output": "%eq.0" },
    { "op": "add", "a": "%native", "b": "0x01", "output": "%add.0" },
    { "op": "mul", "a": "%native", "b": "-0x01", "output": "%mul.0" },
    { "op": "neg", "a": "%native", "output": "%neg.0" },
    { "op": "inv", "a": "%native", "output": "%inv.0" },
    { "op": "not", "a": "%bool", "output": "%not.0" },
    { "op": "and", "inputs": ["%bool", "%not.0"], "output": "%and.0" },
    { "op": "or", "inputs": ["%bool", "%not.0"], "output": "%or.0" },
    { "op": "xor", "inputs": ["%bool", "%not.0"], "output": "%xor.0" },
    { "op": "less_than", "a": "%native", "b": "0x64", "bits": 8, "output": "%lt.0" },
    { "op": "jubjub_scalar_from_native", "native": "%native", "output": "%jsfn.0" },
    { "op": "public_input", "guard": null, "type": "Scalar<BLS12-381>", "output": "%pub.0" },
    { "op": "private_input", "guard": "%bool", "type": "Bytes<32>", "output": "%priv.0" },
    { "op": "to_bytes", "input": "%jj_scalar", "output": "%tb.0" },
    { "op": "from_bytes", "bytes": "%tb.0", "type": "Scalar<Jubjub>", "output": "%fb.0" },
    { "op": "reverse", "bytes": "%bytes", "output": "%rev.0" },
    { "op": "bytes_into_natives", "bytes": "%bytes", "outputs": ["%limb.0", "%limb.1"] },
    { "op": "bytes_from_natives", "inputs": ["%limb.0", "%limb.1"], "len": 32, "output": "%bfn.0" },
    { "op": "output", "vals": ["%add.0"] }
  ]
}
